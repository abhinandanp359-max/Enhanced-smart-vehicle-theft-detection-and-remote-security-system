# ==============================================================================
# SMART VEHICLE THEFT DETECTION - CONFIGURATION & NOTIFICATIONS (.env)
# ==============================================================================

# Video Capture Source:
# Use 0 for laptop webcam, or your phone stream URL:
VIDEO_SOURCE=http://100.114.246.136:4747/video
VEHICLE_ID=veh_01
SUSTAINED_SECONDS=3.0
SOUND_ENABLED=true

# Vehicle GPS Telemetry (Exact College Campus Location & Coordinates)
# GPS_MODE=EXACT ensures Google Maps shows your exact college location (not generic ISP city)
GPS_MODE=EXACT
VEHICLE_LATITUDE=12.9716
VEHICLE_LONGITUDE=77.5946
VEHICLE_LOCATION_NAME=College Campus - Main Parking Bay

# ------------------------------------------------------------------------------
# 📱 FREE TELEGRAM BOT NOTIFICATIONS (Recommended - Takes 1 Minute to Set Up)
# ------------------------------------------------------------------------------
# Step 1: Open Telegram app, search for @BotFather, send /newbot to get your Token
# Step 2: Search for @userinfobot on Telegram, click Start to see your Chat ID
# Step 3: Paste both below:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 💬 WHATSAPP NOTIFICATIONS (Optional via free CallMeBot API)
# ------------------------------------------------------------------------------
# 1. Add CallMeBot on WhatsApp: +34 644 59 13 47
# 2. Send: "I allow callmebot to send me messages"
# 3. Enter your international phone number and the API key received:
WHATSAPP_PHONE=
WHATSAPP_API_KEY=
